{
  "apiVersion": "shipstream.io/v1alpha1",
  "kind": "MysqlFailoverGroup",
  "metadata": {
    "name": "playground",
    "namespace": "bloodraven-playground"
  },
  "spec": {
    "image": "mysql:9.7",
    "sites": [
      {
        "name": "iad",
        "role": "PrimaryCandidate"
      },
      {
        "name": "pdx",
        "role": "PrimaryCandidate"
      },
      {
        "name": "lhr",
        "role": "DisasterRecovery"
      },
      {
        "name": "reader",
        "role": "ReadOnly"
      }
    ],
    "failoverCooldown": "5m",
    "splitBrainPolicy": {
      "sitePriorities": [
        "iad",
        "pdx"
      ]
    }
  },
  "status": {
    "sites": [
      {
        "name": "iad",
        "state": "Unreachable",
        "role": "PrimaryCandidate",
        "replicating": false,
        "secondsBehindSource": null
      },
      {
        "name": "pdx",
        "state": "Unreachable",
        "role": "PrimaryCandidate",
        "replicating": false,
        "secondsBehindSource": null
      },
      {
        "name": "lhr",
        "state": "ReadOnly",
        "role": "DisasterRecovery",
        "replicating": true,
        "secondsBehindSource": 0
      },
      {
        "name": "reader",
        "state": "ReadOnly",
        "role": "ReadOnly",
        "replicating": true,
        "secondsBehindSource": 3
      }
    ]
  }
}
