{
  "apiVersion": "shipstream.io/v1alpha1",
  "kind": "MysqlFailoverGroup",
  "metadata": {
    "name": "playground",
    "namespace": "bloodraven-playground"
  },
  "spec": {
    "image": "mysql:9.7",
    "sites": [
      {
        "name": "iad",
        "role": "primary-candidate"
      },
      {
        "name": "pdx",
        "role": "primary-candidate"
      },
      {
        "name": "reader",
        "role": "read-only"
      }
    ],
    "failoverCooldown": "5m",
    "splitBrainPolicy": {
      "sitePriorities": [
        "iad",
        "pdx"
      ]
    }
  },
  "status": {
    "sites": [
      {
        "name": "iad",
        "state": "writable",
        "role": "primary-candidate",
        "replicating": false,
        "secondsBehindSource": null
      },
      {
        "name": "pdx",
        "state": "writable",
        "role": "primary-candidate",
        "replicating": false,
        "secondsBehindSource": null
      },
      {
        "name": "reader",
        "state": "read-only",
        "role": "read-only",
        "replicating": true,
        "secondsBehindSource": 3
      }
    ],
    "activeSite": "iad"
  }
}
