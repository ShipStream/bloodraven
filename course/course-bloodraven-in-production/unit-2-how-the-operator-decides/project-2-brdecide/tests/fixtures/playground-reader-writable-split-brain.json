{
  "apiVersion": "shipstream.io/v1alpha1",
  "kind": "MysqlFailoverGroup",
  "metadata": {
    "name": "playground",
    "namespace": "bloodraven-playground"
  },
  "spec": {
    "image": "mysql:9.7",
    "sites": [
      {
        "name": "iad",
        "role": "PrimaryCandidate"
      },
      {
        "name": "pdx",
        "role": "PrimaryCandidate"
      },
      {
        "name": "reader",
        "role": "ReadOnly"
      }
    ],
    "failoverCooldown": "5m",
    "splitBrainPolicy": {
      "sitePriorities": [
        "iad",
        "pdx"
      ]
    }
  },
  "status": {
    "sites": [
      {
        "name": "iad",
        "state": "Writable",
        "role": "PrimaryCandidate",
        "replication": "NotApplicable",
        "secondsBehindSource": null
      },
      {
        "name": "pdx",
        "state": "Writable",
        "role": "PrimaryCandidate",
        "replication": "NotApplicable",
        "secondsBehindSource": null
      },
      {
        "name": "reader",
        "state": "Writable",
        "role": "ReadOnly",
        "replication": "NotApplicable",
        "secondsBehindSource": null
      }
    ],
    "activeSite": "iad"
  }
}
