node_modules/
dist/

# Python bytecode from running project starters and tests locally
__pycache__/
*.pyc

# The course build runs on bun and `bun.lock` is tracked, so a stray
# package-lock.json from an ad-hoc `npm install` is noise. Keep it out: npm
# resolves transitive deps independently of bun.lock, which silently changes
# the built output and trips the `course-check` drift gate.
package-lock.json
