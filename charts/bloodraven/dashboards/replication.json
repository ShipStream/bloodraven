{
  "title": "Bloodraven — Replication & Recovery",
  "uid": "bloodraven-replication",
  "tags": ["bloodraven", "mysql", "replication"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "graphTooltip": 1,
  "links": [
    {"title": "Overview", "type": "link", "url": "/d/bloodraven-overview", "icon": "external link", "tags": ["bloodraven"], "keepTime": true, "includeVars": true}
  ],
  "templating": {
    "list": [
      {"name": "datasource", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}, "refresh": 1},
      {
        "name": "ns",
        "label": "namespace",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(bloodraven_site_state, namespace)", "refId": "ns"},
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "group",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(bloodraven_site_state{namespace=~\"$ns\"}, group)", "refId": "group"},
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "site",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(bloodraven_site_state{namespace=~\"$ns\", group=~\"$group\"}, site)", "refId": "site"},
        "refresh": 2, "multi": true, "includeAll": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Max replication lag (active sites)",
      "description": "Ignores the -1 sentinel. The highest lag across all replicating sites.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "max(bloodraven_replication_lag_seconds{namespace=~\"$ns\", group=~\"$group\", site=~\"$site\"} > -1)", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "orange", "value": 60}, {"color": "red", "value": 300}
      ]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Replication threads down",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "sum(bloodraven_replication_running{namespace=~\"$ns\", group=~\"$group\", site=~\"$site\"} == 0)", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 1}
      ]}}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sites with divergent transactions",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "count(bloodraven_divergent_transactions > 0)", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 1}
      ]}, "mappings": [{"type": "value", "options": {"0": {"text": "none"}}}]}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Replication lag per site",
      "description": "-1 means the site is not in replication mode (it's the primary, or broken). Filter negative values in your alerting query.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 5},
      "targets": [{"expr": "bloodraven_replication_lag_seconds{namespace=~\"$ns\", group=~\"$group\", site=~\"$site\"}", "refId": "A", "legendFormat": "{{namespace}}/{{group}}/{{site}} ({{role}})"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true}, "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 300}
      ]}}}
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Replication threads — IO / SQL up?",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "targets": [{"expr": "bloodraven_replication_running{namespace=~\"$ns\", group=~\"$group\", site=~\"$site\"}", "refId": "A", "legendFormat": "{{namespace}}/{{group}}/{{site}} ({{role}}) / {{thread}}"}],
      "options": {"showValue": "auto", "mergeValues": true, "rowHeight": 0.9},
      "fieldConfig": {"defaults": {"mappings": [
        {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
        {"type": "value", "options": {"1": {"text": "up", "color": "green"}}}
      ], "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [
        {"color": "red", "value": null}, {"color": "green", "value": 1}
      ]}}}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Divergent transactions per site",
      "description": "Any non-zero value ⇒ an old primary committed transactions that never replicated to the new primary. Trigger a reclone.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "targets": [{"expr": "bloodraven_divergent_transactions{site=~\"$site\"}", "refId": "A", "legendFormat": "{{site}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 20}, "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 1}
      ]}}}
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Reclone operations per hour",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "targets": [{"expr": "sum by (site) (increase(bloodraven_reclone_operations_total[1h]))", "refId": "A", "legendFormat": "{{site}}"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70}, "unit": "short"}}
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "MySQL poll latency p50 / p95 / p99 per site",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "targets": [
        {"expr": "histogram_quantile(0.5,  sum by (site, le) (rate(bloodraven_poll_latency_seconds_bucket{site=~\"$site\"}[5m])))", "refId": "A", "legendFormat": "p50 {{site}}"},
        {"expr": "histogram_quantile(0.95, sum by (site, le) (rate(bloodraven_poll_latency_seconds_bucket{site=~\"$site\"}[5m])))", "refId": "B", "legendFormat": "p95 {{site}}"},
        {"expr": "histogram_quantile(0.99, sum by (site, le) (rate(bloodraven_poll_latency_seconds_bucket{site=~\"$site\"}[5m])))", "refId": "C", "legendFormat": "p99 {{site}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 5}}}
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Polls/s per site",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "targets": [{"expr": "sum by (site) (rate(bloodraven_poll_latency_seconds_count{site=~\"$site\"}[5m]))", "refId": "A", "legendFormat": "{{site}}"}],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10}}}
    }
  ]
}
